# SelfState .env example
# PostgreSQL connection (Postgres URL format)
POSTGRES_URL=postgres://user:password@localhost:5432/selfstate_db

# Next.js / Web
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# LLM / AI
LLM_PROVIDER=liteLLM
LLM_API_KEY=

# Session / JWT
SESSION_SECRET=replace_this_with_a_strong_secret

# Dokploy / Deploy notes
# DOKPLOY_ENV=production
